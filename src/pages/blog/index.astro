---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="资源推荐">
  <div class="py-24 bg-stone-50 min-h-[70vh] flex items-center justify-center">
    <div class="max-w-xl mx-auto px-6 text-center">
      <div class="mb-8 inline-flex items-center justify-center w-20 h-20 bg-white rounded-full shadow-sm text-4xl">
        📚
      </div>
      
      <h1 class="text-3xl font-bold text-gray-900 mb-4">资源推荐</h1>
      <div class="w-12 h-1 bg-primary-500 mx-auto mb-8"></div>
      
      <p class="text-xl text-gray-600 mb-10 leading-relaxed">
        我们正在精心整理各类属灵资源、书籍推荐与学习材料。<br/>
        <span class="font-medium text-primary-600">内容即将上线，敬请期待...</span>
      </p>

      <a href="/" class="text-primary-600 hover:text-primary-700 font-bold inline-flex items-center gap-2 transition-all">
        <span>←</span> 返回首页浏览其他内容
      </a>
    </div>
  </div>
</BaseLayout>
