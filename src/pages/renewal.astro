---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="全人更新">
  <main class="bg-[#FDFBF9] min-h-screen pb-20">
    
    <section class="py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="mb-16 flex justify-center">
          <div class="w-24 h-24 rounded-full border-2 border-[#D4A373] flex items-center justify-center p-2">
            <div class="w-full h-full rounded-full border border-[#D4A373]/30 flex items-center justify-center text-[#D4A373]">
               <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v18m-9-9h18m-9-9l9 9-9 9-9-9 9-9z"/></svg>
            </div>
          </div>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold text-[#004D40] text-center mb-20 tracking-tight">
          以福音为中心的全人更新
        </h1>

        <div class="grid md:grid-cols-3 gap-12 text-center md:text-left">
          <div class="space-y-6">
            <h2 class="text-3xl font-bold text-[#D4A373] leading-tight">福音是我们生命的<br class="hidden md:block"/>指望和起点。</h2>
            <p class="text-lg text-[#004D40] font-medium leading-relaxed">我们确信，透过信靠耶稣基督为救主，我们获得了新生，从此人生有了盼望。这完全是神的工作，没有我们自己的功劳。</p>
          </div>
          <div class="space-y-6">
            <h2 class="text-3xl font-bold text-[#D4A373] leading-tight">福音是我们持续成长<br class="hidden md:block"/>的动力。</h2>
            <p class="text-lg text-[#004D40] font-medium leading-relaxed">我们每天的努力不是为了换取神的恩典，我们的努力是为了回应神的恩典，因为我们透过耶稣基督的福音已经白白得到了恩典。</p>
          </div>
          <div class="space-y-6">
            <h2 class="text-3xl font-bold text-[#D4A373] leading-tight">福音更新我们人生<br class="hidden md:block"/>的每个层面。</h2>
            <p class="text-lg text-[#004D40] font-medium leading-relaxed">透过福音，神是我们生命的主人，神在我们生命的每个层面都有祂的旨意。我们每天所要做的，就是来到主面前听祂的吩咐并顺服祂。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white/50 border-y border-[#D4A373]/10">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-[#5C5146] text-center mb-16">以福音为中心的全人更新模型</h2>
        
        <div class="flex flex-col md:flex-row items-center justify-center gap-12 lg:gap-20">
          
          <div class="flex-1 space-y-4 max-w-sm">
            <div class="flex items-start gap-3">
              <span class="text-[#D4A373] mt-1">➤</span>
              <p class="text-[#5C5146] leading-relaxed">基于福音，通过研读圣经和属灵操练，寻求神的心意，并与神同行。</p>
            </div>
          </div>

          <div class="relative w-72 h-72 md:w-96 md:h-96 flex-shrink-0">
                        <svg viewBox="0 0 400 400" class="w-full h-full drop-shadow-xl">
              <circle cx="200" cy="200" r="180" fill="#F3E5F5" /> <path d="M 200,200 L 200,20 A 180,180 0 0 1 370,260 Z" fill="#FBE9E7" /> <path d="M 200,200 L 40,300 A 180,180 0 0 0 200,380 Z" fill="#E8F5E9" /> <circle cx="200" cy="200" r="110" fill="#E1F5FE" stroke="white" stroke-width="4"/>
              
              <circle cx="200" cy="200" r="45" fill="#FFF9C4" />
              
              <text x="200" y="205" text-anchor="middle" class="text-sm font-bold fill-[#5C5146]">福音</text>
              <text x="200" y="275" text-anchor="middle" class="text-xs font-bold fill-[#5C5146]">人与神的关系</text>
              <text x="130" y="150" transform="rotate(-45, 130, 150)" class="text-xs font-bold fill-[#5C5146]">人与人的关系</text>
              <text x="280" y="170" transform="rotate(45, 280, 170)" class="text-xs font-bold fill-[#5C5146]">人与环境的关系</text>
              <text x="160" y="340" class="text-xs font-bold fill-[#5C5146]">人与自我的关系</text>
            </svg>
          </div>

          <div class="flex-1 space-y-4 max-w-sm">
            <div class="flex items-start gap-3">
              <span class="text-[#D4A373] mt-1">➤</span>
              <p class="text-[#5C5146] leading-relaxed">按着圣经的原则和圣灵的带领，更新与他人的关系、与自我的关系，以及与外在环境的关系。</p>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* 确保文本渲染清晰 */
  text {
    font-family: system-ui, sans-serif;
    letter-spacing: 0.05em;
  }
</style>
