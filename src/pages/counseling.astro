    role: "资深辅导师 (可预约)",
    qualifications: [
      "资深辅导师资历",
      "加拿大全人更新协会/生命树宣教网络辅导师、培训员",
      "具有丰富的临床辅导经验",
      "专业辅导培训师资历"
    ],
    specialties: ["生命重构", "心理辅导与真理整合", "专业辅导培训"],
    fees: "请咨询确认",
    location: "线上/线下",
    contact: "通过平台预约",
    detail: "致力于陪伴生命在真理中重构与成长。"
  },
  {
    name: "林一",
    role: "资深辅导师 (可预约)",
    qualifications: [
      "资深辅导师资历",
      "加拿大全人更新协会/生命树宣教网络辅导师、培训员",
      "专注于生命整合辅导研究"
    ],
    specialties: ["生命整合辅导", "属灵成长陪伴", "面对生命挑战"],
    fees: "请咨询确认",
    location: "线上/线下",
    contact: "通过平台预约",
    detail: "在陪伴个体面对生命挑战与属灵成长方面有深厚积淀。"
  },
  {
    name: "王静",
    role: "国家三级心理咨询师 (可预约)",
    qualifications: [
      "国家三级心理咨询师",
      "加拿大全人更新协会/生命树宣教网络辅导师、培训员",
      "长期心理辅导实践经验"
    ],
    specialties: ["专业视角与信仰关怀", "内在力量探索", "情绪支持"],
    fees: "请咨询确认",
    location: "线上/线下",
    contact: "通过平台预约",
    detail: "协助来访者探索内在力量，达成全人更新。"
  }
