            <li><a href="/renewal" class="hover:text-white transition-colors">全人更新模型</a></li>
          </ul>
        </div>

        <div>
          <h3 class="text-white font-bold mb-4">联系我们</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li>邮箱: YGTX2024@outlook.com</li>
            <li>微信: Janewang1976 (预约)</li>
          </ul>
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-4 mt-12 pt-8 border-t border-gray-800 text-center text-xs">
        <p>© 2026 与光同行. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
