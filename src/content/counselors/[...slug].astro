---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const counselorEntries = await getCollection('counselors');
  return counselorEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.name} - 心理咨询师`}>
  <main class="bg-[#F9F4EF] min-h-screen py-16 px-4">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-sm overflow-hidden">
      
      <div class="p-8 md:p-16 text-center border-b border-gray-50">
        <h1 class="text-4xl md:text-5xl font-bold text-[#5C5146] mb-4">{entry.data.name}</h1>
        <p class="text-xl md:text-2xl text-[#D4A373] font-medium mb-6">{entry.data.title}</p>
        <div class="w-16 h-1 bg-[#D4A373]/30 mx-auto mb-6"></div>
        <p class="text-gray-600 leading-relaxed italic text-lg">"{entry.data.description}"</p>
      </div>

      <div class="p-8 md:p-16">
        <div class="prose prose-stone max-w-none 
          prose-h3:text-[#D4A373] prose-h3:border-l-4 prose-h3:border-[#D4A373] prose-h3:pl-4 prose-h3:mt-10 prose-h3:mb-4
          prose-p:text-gray-700 prose-p:leading-loose
          prose-li:text-gray-700 prose-li:my-2">
          <Content />
        </div>
        
        <div class="mt-20 p-8 bg-[#FDFBF9] rounded-2xl border border-[#D4A373]/10 text-center">
          <p class="text-[#5C5146] font-medium italic">
            “愿主耶稣基督的恩惠、上帝的慈爱、圣灵的感动，常与你们众人同在。”
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto mt-10 text-center">
      <a href="/counseling" class="text-gray-400 hover:text-[#D4A373] transition-colors flex items-center justify-center gap-2">
