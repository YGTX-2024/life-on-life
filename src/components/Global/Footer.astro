---
const currentYear = new Date().getFullYear();

// 定义左侧链接列
const linksLeft = [
  { text: "信仰告白", href: "/confession" },
  { text: "心理辅导", href: "/counseling" },
  { text: "全人更新", href: "/renewal" },
];

// 定义右侧链接列
const linksRight = [
  { text: "资源分享", href: "/blog" },
  { text: "奉献支持", href: "/giving" },
  { text: "加入我们", href: "/join" }, // 新增项
];
---

<footer class="bg-white border-t border-gray-100 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
      
      <div class="flex flex-col space-y-5">
        <div class="flex items-center">
          <img 
            src="/uploads/logo-new.png" 
            alt="与光同行 Logo" 
            class="h-12 w-auto mr-3"
          />
          <span class="text-2xl font-bold text-[#5C5146] font-serif tracking-tight">与光同行</span>
        </div>
        <p class="text-gray-500 text-sm leading-relaxed max-w-xs">
          来，一起经历与主耶稣同行的全人更新。
        </p>
      </div>

      <div class="grid grid-cols-2 gap-4 lg:pt-2">
        <ul class="space-y-4 p-0 list-none">
          {linksLeft.map(link => (
            <li>
              <a href={link.href} class="text-gray-600 hover:text-[#D4A373] transition-colors no-underline text-base font-medium">
                {link.text}
              </a>
            </li>
          ))}
        </ul>
        <ul class="space-y-4 p-0 list-none">
          {linksRight.map(link => (
            <li>
              <a href={link.href} class="text-gray-600 hover:text-[#D4A373] transition-colors no-underline text-base font-medium">
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="flex flex-col">
        <h4 class="text-[#5C5146] font-bold mb-6 text-base tracking-widest uppercase">联系我们</h4>
        <div class="space-y-3 text-sm text-gray-500">
          <p class="flex items-center gap-2">
            <span class="font-bold text-[#D4A373]">小鸽子号:</span> 8086245 (idigest)
          </p>
          <p class="flex items-center gap-2">
            <span class="font-bold text-[#D4A373]">Signal:</span> +1 2344329189
          </p>
          <div class="pt-1 flex flex-col space-y-1">
            <a href="mailto:YGTX2024@outlook.com" class="text-gray-500 hover:text-[#D4A373] no-underline transition-colors">YGTX2024@outlook.com</a>
            <a href="mailto:ygtx2024@gmail.com" class="text-gray-500 hover:text-[#D4A373] no-underline transition-colors">ygtx2024@gmail.com</a>
          </div>
        </div>
      </div>

    </div>

    <div class="pt-8 border-t border-gray-50 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-400 tracking-widest">
        &copy; {currentYear} 与光同行 WALKING WITH LIGHT. All rights reserved.
      </p>
      <div class="flex gap-6">
        <span class="text-[10px] text-gray-300 uppercase tracking-[0.2em] font-medium">Faith · Hope · Love</span>
      </div>
    </div>
  </div>
</footer>
