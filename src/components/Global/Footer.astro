---
const currentYear = new Date().getFullYear();

// 定义与顶端导航一致的链接
const footerLinks = [
  { text: "信仰告白", href: "/confession" },
  { text: "心理辅导", href: "/counseling" },
  { text: "全人更新", href: "/renewal" },
  { text: "资源分享", href: "/blog" },
  { text: "奉献支持", href: "/giving" },
];
---

<footer class="bg-white border-t border-gray-100 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      
      <div class="flex flex-col">
        <div class="flex items-center mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" class="h-8 w-auto text-[#D4A373] mr-3">
            <path fill="currentColor" d="M344 24c0-13.3-10.7-24-24-24s-24 10.7-24 24v46.4L183.3 210c-14.5 8.7-23.3 24.3-23.3 41.2V464c0 26.5 21.5 48 48 48h224c26.5 0 48-21.5 48-48V251.2c0-16.9-8.8-32.5-23.3-41.2L344 70.4V24zM256 464V336h128v128H256z"/>
          </svg>
          <span class="text-2xl font-bold text-[#5C5146] tracking-wider font-serif">与光同行</span>
        </div>
        <p class="text-gray-500 leading-relaxed max-w-xs">
          致力于以福音为中心的全人更新，陪伴生命共同成长。
        </p>
      </div>

      <div>
        <h4 class="text-[#5C5146] font-bold mb-6 text-lg">快速链接</h4>
        <ul class="space-y-4">
          {footerLinks.map(link => (
            <li>
              <a href={link.href} class="text-gray-500 hover:text-[#D4A373] transition-colors no-underline">
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-[#5C5146] font-bold mb-6 text-lg">联系我们</h4>
        <ul class="space-y-4 text-gray-500">
          <li class="flex items-center gap-2">
            <span class="font-medium text-[#D4A373]">邮箱:</span>
            <a href="mailto:YGTX2024@outlook.com" class="hover:text-[#D4A373] transition-colors no-underline">YGTX2024@outlook.com</a>
          </li>
          <li class="flex items-center gap-2">
            <span class="font-medium text-[#D4A373]">微信:</span>
            <span>Janewang1976 (预约)</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="pt-8 border-t border-gray-50 text-center">
      <p class="text-sm text-gray-400">
        &copy; {currentYear} 与光同行. All rights reserved.
      </p>
    </div>
  </div>
</footer>
