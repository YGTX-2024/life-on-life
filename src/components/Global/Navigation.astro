---
import { getCollection } from 'astro:content';

// 获取所有咨询师资料
let counselors = [];
try {
  counselors = await getCollection('counselors');
} catch (e) {
  console.warn("目前无法获取咨询师列表");
}
// 定义基础导航项
const navItems = [
  { text: "主页", href: "/" },
  { text: "信仰告白", href: "/confession" },
  { text: "心理辅导", href: "/counseling", hasDropdown: true },
  { text: "全人更新", href: "/renewal" },
  { text: "资源推荐", href: "/blog" },
  { text: "奉献支持", href: "/giving" },
];

const currentPath = Astro.url.pathname;
---

<nav class="hidden lg:block">
  <ul class="flex items-center space-x-10">
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href || 
                         (item.href !== "/" && currentPath.startsWith(item.href));
        
        if (item.hasDropdown) {
          return (
            <li class="relative group py-4"> <a
                href={item.href}
                class={`text-2xl font-medium transition-colors hover:text-[#D4A373] flex items-center gap-1 ${
                  isActive ? "text-[#D4A373]" : "text-[#5C5146]"
                }`}
              >
                {item.text}
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
              
              <div class="absolute left-0 pt-2 hidden group-hover:block z-50">
                <ul class="w-60 bg-white border border-gray-100 shadow-2xl rounded-2xl py-3 overflow-hidden">
                  <li>
                    <a href="/counseling" class="block px-6 py-3 text-lg text-gray-700 hover:bg-[#F9F4EF] hover:text-[#D4A373] transition-colors">
                      辅导立场与伦理
                    </a>
                  </li>
                  <div class="border-t border-gray-100 my-1"></div>
                  {counselors.sort((a,b) => (a.data.order || 99) - (b.data.order || 99)).map(c => (
                    <li>
                      <a href={`/counselors/${c.slug}`} class="block px-6 py-3 text-lg text-gray-700 hover:bg-[#F9F4EF] hover:text-[#D4A373] transition-colors">
                        咨询师：{c.data.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          );
        }

        return (
          <li>
            <a
              href={item.href}
              class={`text-2xl font-medium transition-colors hover:text-[#D4A373] ${
                isActive ? "text-[#D4A373]" : "text-[#5C5146]"
              }`}
              aria-current={isActive ? "page" : undefined}
            >
              {item.text}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<button
  id="mobile-menu-button"
  class="lg:hidden p-2 text-gray-700 hover:text-[#D4A373] focus:outline-none transition-colors relative"
  aria-label="Toggle Menu"
  aria-expanded="false"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<div
  id="mobile-menu"
  class="absolute top-full left-0 right-0 bg-white shadow-lg border-t border-gray-100 transform scale-y-0 origin-top transition-transform duration-200 ease-out lg:hidden z-50"
>
  <div class="px-4 py-6">
    <div class="grid grid-cols-2 gap-3">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="block px-4 py-3 text-sm font-medium rounded-lg text-gray-700 bg-gray-50 text-center"
          >
            {item.text}
          </a>
        ))
      }
      {counselors.map(c => (
        <a 
          href={`/counselors/${c.slug}`}
          class="block px-4 py-3 text-sm font-medium rounded-lg text-[#D4A373] bg-[#F9F4EF] border border-[#D4A373]/20 text-center"
        >
          {c.data.name}
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  #mobile-menu.show { transform: scaleY(1); }
</style>

<script>
  const setupMenu = () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    if (!mobileMenuButton || !mobileMenu) return;

    mobileMenuButton.addEventListener('click', () => {
      const isShow = mobileMenu.classList.toggle('show');
      mobileMenuButton.setAttribute('aria-expanded', isShow.toString());
    });
  };
  setupMenu();
  document.addEventListener('astro:after-swap', setupMenu);
</script>
