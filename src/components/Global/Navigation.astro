---
import { getCollection } from 'astro:content';

let counselors = [];
try {
  counselors = await getCollection('counselors');
} catch (e) {
  console.warn("无法获取咨询师列表");
}

const navItems = [
  { text: "主页", href: "/" },
  { text: "信仰告白", href: "/confession" },
  { text: "心理辅导", href: "/counseling", hasDropdown: true },
  { text: "全人更新", href: "/renewal" },
  { text: "资源推荐", href: "/blog" },
  { text: "奉献支持", href: "/giving" },
];

const currentPath = Astro.url.pathname;
---

<nav class="hidden lg:flex justify-end flex-1">
  <ul class="flex items-center space-x-7">
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href || 
                        (item.href !== "/" && currentPath.startsWith(item.href));

        if (item.hasDropdown) {
          return (
            <li class="relative group">
              <button class={`flex items-center gap-1 py-2 text-[15px] font-medium transition-colors ${isActive ? 'text-[#D4A373]' : 'text-[#5C5146] hover:text-[#D4A373]'}`}>
                {item.text}
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                </svg>
              </button>
              
              <div class="absolute right-0 w-48 mt-0 origin-top-right bg-white border border-gray-100 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="py-2">
                  <a href="/counseling" class="block px-4 py-2 text-sm text-gray-700 hover:bg-[#FDFCFB] hover:text-[#D4A373]">
                    辅导介绍
                  </a>
                  <div class="h-px mx-2 my-1 bg-gray-50" />
                  {counselors.sort((a, b) => (a.data.order || 99) - (b.data.order || 99)).map((counselor) => (
                    <a href={`/counselors/${counselor.slug}`} class="block px-4 py-2 text-sm text-gray-600 hover:bg-[#FDFCFB] hover:text-[#D4A373]">
                      {counselor.data.name}
                    </a>
                  ))}
                </div>
              </div>
            </li>
          );
        }

        return (
          <li>
            <a 
              href={item.href}
              class={`block py-2 text-[15px] font-medium transition-colors whitespace-nowrap ${isActive ? 'text-[#D4A373]' : 'text-[#5C5146] hover:text-[#D4A373]'}`}
            >
              {item.text}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
