---
import { getCollection } from 'astro:content';

let counselors = [];
try {
  counselors = await getCollection('counselors');
} catch (e) {
  console.warn("无法获取咨询师列表");
}

const navItems = [
  { text: "主页", href: "/" },
  { text: "信仰告白", href: "/confession" },
  { text: "心理辅导", href: "/counseling", hasDropdown: true },
  { text: "全人更新", href: "/renewal" },
  { text: "资源推荐", href: "/blog" },
  { text: "奉献支持", href: "/giving" },
];

const currentPath = Astro.url.pathname;
---

<nav id="nav-menu" class="hidden lg:block absolute lg:static top-24 left-0 w-full lg:w-auto bg-white lg:bg-transparent shadow-xl lg:shadow-none z-[100]">
  <ul class="flex flex-col lg:flex-row items-start lg:items-center p-6 lg:p-0 space-y-4 lg:space-y-0 lg:space-x-8">
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));

        return (
          <li class="relative group w-full lg:w-auto">
            {item.hasDropdown ? (
              <button class={`flex items-center gap-1.5 py-2 text-xl font-bold transition-colors ${isActive ? 'text-[#D4A373]' : 'text-[#5C5146] hover:text-[#D4A373]'}`}>
                {item.text}
                <svg class="w-5 h-5 opacity-50 group-hover:rotate-180 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                </svg>
              </button>
            ) : (
              <a href={item.href} class={`block py-2 text-xl font-bold transition-colors whitespace-nowrap ${isActive ? 'text-[#D4A373]' : 'text-[#5C5146] hover:text-[#D4A373]'}`}>
                {item.text}
              </a>
            )}

            {item.hasDropdown && (
              <div class="lg:absolute left-0 w-full lg:w-48 pt-2 lg:opacity-0 lg:invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="bg-gray-50 lg:bg-white border border-gray-100 rounded-lg shadow-inner lg:shadow-xl py-2">
                  <a href="/counseling" class="block px-4 py-2 text-sm font-medium text-gray-700 hover:text-[#D4A373]">辅导介绍</a>
                  {counselors.map((c) => (
                    <a href={`/counselors/${c.slug}`} class="block px-4 py-2 text-sm text-gray-600 hover:text-[#D4A373]">{c.data.name}</a>
                  ))}
                </div>
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</nav>
