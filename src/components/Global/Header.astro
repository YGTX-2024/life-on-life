---
import Navigation from "./Navigation.astro";
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md shadow-md border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 lg:px-12 flex items-center justify-between h-24 lg:h-32">
    
    <a href="/" class="flex items-center shrink-0 group no-underline">
      <img 
        src="/uploads/logo-new.png" 
        alt="与光同行 Logo" 
        class="h-14 lg:h-20 w-auto mr-3 transition-transform group-hover:scale-105"
      />
      
      <div class="flex flex-col">
        <span class="text-2xl lg:text-4xl font-bold text-[#5C5146] tracking-[0.1em] lg:tracking-[0.2em] font-serif uppercase">与光同行</span>
        <span class="text-[8px] lg:text-[10px] text-[#D4A373] tracking-[0.3em] lg:tracking-[0.5em] mt-0.5 font-sans opacity-80">WALKING WITH LIGHT</span>
      </div>
    </a>

    <div class="flex items-center">
      <Navigation />
      
      <button id="menu-toggle" class="lg:hidden ml-4 p-2 text-[#5C5146]" aria-label="Toggle Menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>

  </div>
</header>

<script>
  // 手机菜单点击显示/隐藏逻辑
  // 请确保 Navigation.astro 中的 nav 标签 id 是 nav-menu
  const btn = document.getElementById('menu-toggle');
  const nav = document.getElementById('nav-menu');
  btn?.addEventListener('click', () => {
    nav?.classList.toggle('hidden');
  });
</script>
