---
import Button from "../UI/Button.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  title = "Welcome to Our Church",
  subtitle = "A place of worship, community, and spiritual growth",
  backgroundImage = "/uploads/hero-bg.jpg",
  ctaText = "心理辅导",
  ctaLink = "/im-new",
  secondaryCtaText = "全人更新",
  secondaryCtaLink = "/sermons",
} = Astro.props;
---

<section
  class="relative min-h-[70vh] flex items-center bg-cover pt-30"
  style={`background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url(${backgroundImage}); background-position: center 20%;`}
>
  <div class="max-w-7xl mx-auto w-full px-6 pl-12 lg:pl-40"> 
    <div class="max-w-3xl text-white">
      <h1 class="text-4xl md:text-7xl font-bold mb-6 text-white tracking-tight">{title}</h1>
      <p class="text-xl md:text-2xl mb-10 opacity-90">{subtitle}</p>

      <div class="flex flex-wrap gap-5 mt-10">
        <a 
          href={ctaLink} 
          class="bg-[#D4A373] hover:bg-[#C29262] text-white px-10 py-4 rounded-md font-bold transition-all shadow-xl no-underline text-lg"
        >
          {ctaText}
        </a>

        <a 
          href={secondaryCtaLink} 
          class="bg-white/10 hover:bg-white/20 text-white border border-white px-10 py-4 rounded-md font-bold transition-all backdrop-blur-sm no-underline text-lg"
        >
          {secondaryCtaText}
        </a>
      </div>
    </div>
  </div>
</section>
