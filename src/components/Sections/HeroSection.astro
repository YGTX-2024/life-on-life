---
import Button from "../UI/Button.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
  secondaryCtaText?: string;
  secondaryCtaLink?: string;
}

const {
  title = "Welcome to Our Church",
  subtitle = "A place of worship, community, and spiritual growth",
  backgroundImage = "/uploads/hero-bg.jpg",
  ctaText = "心理辅导",
  ctaLink = "/im-new",
  secondaryCtaText = "全人更新",
  secondaryCtaLink = "/sermons",
} = Astro.props;
---

<section
  class="relative min-h-[70vh] flex items-center bg-cover pt-20 lg:pt-30"
  style={`background-image: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url(${backgroundImage}); background-position: center 20%;`}
>
  <div class="max-w-7xl mx-auto w-full px-8 lg:pl-48"> 
    <div class="max-w-3xl text-white">
      <h1 class="text-4xl md:text-7xl font-bold mb-6 text-white tracking-tight leading-tight">
        {title}
      </h1>
      
      <p class="text-lg md:text-2xl mb-10 opacity-90 leading-relaxed max-w-[260px] md:max-w-full">
        {subtitle}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <a href={ctaLink} class="text-center bg-[#D4A373] text-white px-8 py-4 rounded-md font-bold text-lg shadow-xl no-underline">
          {ctaText}
        </a>
        <a href={secondaryCtaLink} class="text-center bg-white/10 text-white border border-white px-8 py-4 rounded-md font-bold backdrop-blur-sm text-lg no-underline">
          {secondaryCtaText}
        </a>
      </div>
    </div>
  </div>
</section>
